# ================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ================================
# Project Specific
# ================================
# Backup directory
backup/
backups/

# Original Darknet compiled files (keep source)
darknet
libdarknet.so
libdarknet.a
*.o

# Keep cfg and src for reference
!cfg/
!src/

# Temporary files
tmp/
temp/
*.tmp

# Test outputs
test_outputs/
debug_outputs/

# Exported models
*.onnx
*.torchscript
*.engine
*.trt

# Except for final release models
!models/exported/*.onnx

# ================================
# Documentation
# ================================
# Build artifacts
docs/build/
docs/_build/
docs/api/

# ================================
# Miscellaneous
# ================================
# Backup files
*.bak
*.backup

# Compressed files (except small config archives)
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# System files
*.log
*.err
*.out

# Credentials
credentials.json
secrets.yaml
.secrets

# Local configuration overrides
local_config.yaml
local_settings.py

# ================================
# Keep Important Files
# ================================
# Configuration templates
!configs/**/*.yaml
!configs/**/*.yml

# Documentation
!docs/*.md
!*.md

# Scripts
!scripts/*.py
!scripts/*.sh

# Tests
!tests/*.py
